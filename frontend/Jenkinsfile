pipeline {
  agent any

  environment {
    AWS_ACCOUNT_ID = '277385995709'
    AWS_REGION     = 'us-east-1'
    ECR_REGISTRY   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    ECR_REPO       = 'streamingapp/frontend'

    // Fill this in once the Ingress host is live (Step 4/5) — CRA bakes it
    // into the static bundle at BUILD time, so it can't be changed at runtime.
    // No angle brackets — they're shell redirection operators inside sh steps.
    INGRESS_HOST = 'http://a3dfafb4dfc184988acad0aacc6cfe54-1407284491.us-east-1.elb.amazonaws.com'
  }

  stages {
    stage('Checkout') {
      steps {
        script { env.LAST_STAGE = 'Checkout' }
        checkout scm
        script { env.IMAGE_TAG = env.GIT_COMMIT.take(7) }
      }
    }

    stage('Install & Test') {
      steps {
        script { env.LAST_STAGE = 'Install & Test' }
        dir('frontend') {
          sh 'docker run --rm -v $PWD:/app -w /app node:18-alpine npm ci'
        }
      }
    }

    stage('Build Image') {
      steps {
        script { env.LAST_STAGE = 'Build Image' }
        sh """
          docker build --platform linux/amd64 \
            --build-arg REACT_APP_AUTH_API_URL=${INGRESS_HOST}/api/auth \
            --build-arg REACT_APP_STREAMING_API_URL=${INGRESS_HOST}/api/streaming \
            --build-arg REACT_APP_STREAMING_PUBLIC_URL=${INGRESS_HOST} \
            --build-arg REACT_APP_ADMIN_API_URL=${INGRESS_HOST}/api/admin \
            --build-arg REACT_APP_CHAT_API_URL=${INGRESS_HOST}/api/chat \
            --build-arg REACT_APP_CHAT_SOCKET_URL=${INGRESS_HOST} \
            -t ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG} \
            -t ${ECR_REGISTRY}/${ECR_REPO}:latest \
            frontend
        """
      }
    }

    stage('Push to ECR') {
      steps {
        script { env.LAST_STAGE = 'Push to ECR' }
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'streamingapp-tanishq-aws-creds']]) {
          sh """
            aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
            docker push ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
            docker push ${ECR_REGISTRY}/${ECR_REPO}:latest
          """
        }
      }
    }
  }

  post {
    success {
      echo "SUCCESS: streamingapp/frontend image ${env.IMAGE_TAG} pushed. Commit: ${env.GIT_COMMIT}"
    }
    failure {
      echo "FAILED at stage [${env.LAST_STAGE ?: 'Checkout'}] — commit ${env.GIT_COMMIT}"
    }
    always {
      sh "docker logout ${ECR_REGISTRY} || true"
    }
  }
}
